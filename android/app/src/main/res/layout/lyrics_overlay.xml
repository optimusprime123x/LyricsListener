<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lyricsOverlayContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background_shape"
    android:padding="12dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/songInfoTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/translateButton"
        tools:text="Very Long Song Title That Might Wrap - Artist Name With Many Words"
        android:shadowColor="#AA000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"/>

    <ImageButton
        android:id="@+id/translateButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_translate_24"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:contentDescription="Toggle translated lyrics"
        app:layout_constraintTop_toTopOf="@id/songInfoTextView"
        app:layout_constraintBottom_toBottomOf="@id/songInfoTextView"
        app:layout_constraintEnd_toStartOf="@id/expandCollapseButton"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <ImageButton
        android:id="@+id/expandCollapseButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_round_keyboard_arrow_down_24"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:contentDescription="Expand or collapse lyrics"
        app:layout_constraintTop_toTopOf="@id/songInfoTextView"
        app:layout_constraintBottom_toBottomOf="@id/songInfoTextView"
        app:layout_constraintEnd_toStartOf="@id/closeButton"
        android:layout_marginEnd="8dp"/>


    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_round_close_24"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:contentDescription="Close lyrics window"
        app:layout_constraintTop_toTopOf="@id/songInfoTextView"
        app:layout_constraintBottom_toBottomOf="@id/songInfoTextView"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- A Barrier ensures the RecyclerView always starts below the entire header -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="songInfoTextView,translateButton,expandCollapseButton,closeButton" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lyricsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_lyric_line"
        tools:itemCount="5"/>

</androidx.constraintlayout.widget.ConstraintLayout>